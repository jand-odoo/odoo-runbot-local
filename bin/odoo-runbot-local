#!/usr/bin/env python3
"""Launcher: runs the CLI straight from the repository.

Deliberately not a pip entry point. Setup has to run before any virtualenv
exists, so the CLI must work with nothing but the system interpreter.
"""
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if REPO not in sys.path:
    sys.path.insert(0, REPO)

if sys.version_info < (3, 9):
    sys.stderr.write('odoo-runbot-local needs Python 3.9 or newer '
                     f'(found {sys.version.split()[0]})\n')
    raise SystemExit(1)

from odoo_runbot_local.__main__ import main  # noqa: E402

if __name__ == '__main__':
    raise SystemExit(main())
