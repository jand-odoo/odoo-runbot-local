[Unit]
Description=odoo-runbot-local — Run Odoo branches locally from runbot
Wants=postgresql.service
After=network.target postgresql.service

[Service]
Type=simple
ExecStart=%h/.odoo-runbot-local/venv/bin/python %h/.odoo-runbot-local/server.py
Restart=always
RestartSec=5
# The server rotates its own log file; the journal keeps startup crashes
# visible without growing an unbounded file on disk.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
