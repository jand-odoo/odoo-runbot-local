{
  "manifest_version": 2,
  "name": "Odoo Runbot Local",
  "version": "1.0",
  "description": "Run Odoo branches locally from runbot with one click",
  "permissions": [
    "storage",
    "http://127.0.0.1:8765/*",
    "https://runbot.odoo.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://runbot.odoo.com/runbot/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Odoo Runbot Local",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "odoo-runbot-local@example.com",
      "strict_min_version": "91.0"
    }
  }
}
