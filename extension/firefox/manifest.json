{
  "manifest_version": 2,
  "name": "Odoo Runbot Local",
  "version": "1.2",
  "description": "Run Odoo branches locally from runbot with one click",
  "permissions": [
    "storage",
    "tabs",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://runbot.odoo.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://runbot.odoo.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Odoo Runbot Local",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "odoo-runbot-local@example.com",
      "strict_min_version": "91.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
